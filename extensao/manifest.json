{
  "manifest_version": 3,
  "name": "HORASIS — Licitações",
  "version": "1.1.0",
  "description": "Robô de lances para Comprasnet e Licitanet, e preenchimento automático do cadastro de fornecedor nas plataformas de licitação.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://*.gov.br/*",
    "https://*.serpro.gov.br/*",
    "https://serpro.gov.br/*",
    "https://*.licitanet.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.gov.br/*",
        "https://*.serpro.gov.br/*",
        "https://serpro.gov.br/*"
      ],
      "js": [
        "netprobe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://cnetmobile.estaleiro.serpro.gov.br/*"
      ],
      "js": [
        "dispute.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.licitanet.com.br/*"
      ],
      "js": [
        "licitanet-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://portal.licitanet.com.br/*"
      ],
      "js": [
        "licitanet-dispute.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.gov.br/*",
        "https://*.licitanet.com.br/*",
        "https://*.bll.org.br/*",
        "https://*.bllcompras.com/*",
        "https://*.bnc.org.br/*",
        "https://*.portaldecompraspublicas.com.br/*",
        "https://*.licitardigital.com.br/*",
        "https://*.comprasbr.com.br/*",
        "https://*.bbmnetlicitacoes.com.br/*",
        "https://*.licitacoes-e.com.br/*",
        "https://*.compraspublicas.com.br/*",
        "https://*.publinexo.com.br/*",
        "https://*.comprasnet.com.br/*"
      ],
      "js": [
        "cadastro-campos.js",
        "cadastro-preenchimento.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icone-16.png",
        "icone-48.png",
        "icone-128.png",
        "icone.png"
      ],
      "matches": [
        "https://*.gov.br/*",
        "https://*.serpro.gov.br/*",
        "https://*.licitanet.com.br/*"
      ]
    }
  ],
  "action": {
    "default_title": "HORASIS — Licitações",
    "default_icon": {
      "16": "icone-16.png",
      "48": "icone-48.png",
      "128": "icone-128.png"
    }
  },
  "icons": {
    "16": "icone-16.png",
    "48": "icone-48.png",
    "128": "icone-128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
