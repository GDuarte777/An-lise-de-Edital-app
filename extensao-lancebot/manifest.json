{
  "manifest_version": 3,
  "name": "HORASIS LanceBot",
  "version": "1.0.0",
  "description": "Robô de lances para o Compras.gov.br. Reconhece a disputa, você configura piso e decremento por item e liga.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://cnetmobile.estaleiro.serpro.gov.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cnetmobile.estaleiro.serpro.gov.br/*"
      ],
      "js": [
        "pagina.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://cnetmobile.estaleiro.serpro.gov.br/*"
      ],
      "js": [
        "margem.js",
        "conteudo.js",
        "painel.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "HORASIS LanceBot",
    "default_popup": "popup.html"
  }
}
