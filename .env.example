# GEMINI_API_KEY: Fallback key for Gemini AI API calls.
# Only used when ALLOW_SERVER_AI_KEY_FALLBACK is enabled (see below).
# In normal operation each user configures their own key in "IA & Modelos".
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ALLOW_SERVER_AI_KEY_FALLBACK: Set to "true" to let requests without a
# user-configured key fall back to GEMINI_API_KEY / OPENAI_API_KEY above.
# Leave unset in production: those calls are billed to whoever deployed the
# app, not to the user making the request. Intended for local development.
ALLOW_SERVER_AI_KEY_FALLBACK=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase database integration:
# Set these keys to sync analyses and certs directly into your Supabase Postgres database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# Limite de requisições por minuto, por usuário autenticado (ou por IP, quando
# não há sessão). Deixe em branco para usar os padrões, que são folgados para
# uso normal e só barram laço acidental no cliente e abuso direto na API.
#   RATE_LIMIT_IA_POR_MINUTO      rotas que gastam token de IA (padrão: 20)
#   RATE_LIMIT_UPLOAD_POR_MINUTO  envio de PDF em partes (padrão: 300)
#   RATE_LIMIT_API_POR_MINUTO     demais rotas, como consultas ao PNCP (padrão: 120)
RATE_LIMIT_IA_POR_MINUTO=""
RATE_LIMIT_UPLOAD_POR_MINUTO=""
RATE_LIMIT_API_POR_MINUTO=""

# AI_KEYS_ENCRYPTION_KEY: criptografa em repouso as chaves de API de IA dos
# usuarios na tabela configuracoes_usuario (AES-256-GCM).
#
# Sem esta variavel a plataforma funciona exatamente como antes, com as chaves
# em texto puro no banco - legiveis por qualquer um com acesso ao painel do
# Supabase, a um backup ou a uma service key vazada.
#
# Gere com:  openssl rand -hex 32
#
# Depois de definida, as chaves gravadas passam a ser cifradas. As antigas
# continuam funcionando em texto puro e sao convertidas quando o usuario salvar
# as configuracoes de novo. NAO PERCA esta chave: sem ela as chaves cifradas
# nao podem ser lidas, e cada usuario precisara cadastrar a sua novamente.
AI_KEYS_ENCRYPTION_KEY=""
