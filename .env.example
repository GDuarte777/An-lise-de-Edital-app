# ══════════════════════════════════════════════════════════════════════
# VARIÁVEIS DO FRONTEND (.env.local, lidas pelo Vite no build)
#
# Só estas três entram no pacote entregue ao navegador. NUNCA coloque aqui
# chave de IA, service key do Supabase ou token de gerenciamento: tudo com
# prefixo VITE_ é público por definição.
# ══════════════════════════════════════════════════════════════════════

# Projeto Supabase usado pelo frontend (banco, login e backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VITE_API_BASE: para onde vão as chamadas /api/*.
# Em branco, o frontend usa <VITE_SUPABASE_URL>/functions/v1, que é o backend
# publicado. Preencha para falar com um backend local:
#   VITE_API_BASE=http://127.0.0.1:54321/functions/v1
VITE_API_BASE=

# ══════════════════════════════════════════════════════════════════════
# SEGREDOS DO BACKEND
#
# O backend é a Edge Function `api` do Supabase. Estas variáveis NÃO vão em
# arquivo: configure em Supabase → Edge Functions → api → Secrets, ou com
#   supabase secrets set NOME=valor --project-ref <ref>
#
# SUPABASE_URL e SUPABASE_ANON_KEY são injetados pela própria plataforma.
# ══════════════════════════════════════════════════════════════════════

# AI_KEYS_ENCRYPTION_KEY: cifra as chaves de API dos usuários em repouso.
# Gere com `openssl rand -hex 32`. Sem ela as chaves ficam em texto puro na
# tabela, e /api/health devolve chavesIaCriptografadas: false avisando disso.
AI_KEYS_ENCRYPTION_KEY=

# GEMINI_API_KEY + ALLOW_SERVER_AI_KEY_FALLBACK: chave da plataforma, usada
# quando o usuário não tem a sua. Desligada por padrão porque cada chamada é
# cobrada de quem publicou, não de quem usou. O modelo do produto é cada
# usuário trazer a própria chave, configurada em "IA & Modelos".
GEMINI_API_KEY=
ALLOW_SERVER_AI_KEY_FALLBACK=

# Usados apenas por /api/supabase/sync-secrets. O token é de gerenciamento:
# quem o tiver administra o projeto inteiro. Ele vive só aqui, nunca no código.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Limites por minuto, por usuário autenticado (ou por IP, se anônimo).
RATE_LIMIT_IA_POR_MINUTO=
RATE_LIMIT_UPLOAD_POR_MINUTO=
RATE_LIMIT_API_POR_MINUTO=

# Consulta ao PNCP: tempo por requisição, orçamento total da varredura e
# quantas consultas seguem em paralelo.
PNCP_TIMEOUT_MS=
PNCP_ORCAMENTO_MS=
PNCP_CONCORRENCIA=

# Teto do corpo da requisição, em bytes. Acima dele o cliente recebe um 413
# explicando que editais extensos sobem em partes por /api/upload-chunk.
MAX_REQUEST_BODY_BYTES=

# DIAGNOSTICO_ATIVO=false desliga a gravação em logs_diagnostico.
DIAGNOSTICO_ATIVO=
